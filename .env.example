# LifeLedger settings.
# Copy this file to .env and set the values. Never commit .env.

# HTTP listen address. If this is empty, LifeLedger uses $PORT, then ":8080".
LIFELEDGER_ADDR=:8080

# Bearer token for the HTTP API (/api/v1). Use 24 or more random characters,
# for example the output of "openssl rand -hex 32". Necessary when LIFELEDGER_ENV is prod.
LIFELEDGER_API_TOKEN=

# Directory of the built web app ("make web"). The server serves it at /.
LIFELEDGER_WEB_DIR=web/dist/browser

# Add the demo data at startup when the database is empty (true or false).
LIFELEDGER_SEED_DEMO=false

# "dev" gives text logs. "prod" gives JSON logs.
LIFELEDGER_ENV=dev

# debug, info, warn, or error.
LIFELEDGER_LOG_LEVEL=info

# SQLite database file. LifeLedger makes the directory if it does not exist.
LIFELEDGER_DB_PATH=data/lifeledger.db

# IANA time zone of the user, for example Asia/Kolkata. It sets the date "today".
LIFELEDGER_TIMEZONE=UTC

# Default ISO 4217 currency for amounts, for example INR.
LIFELEDGER_CURRENCY=USD

# Nebius Token Factory API key. Get it at https://tokenfactory.nebius.com.
NEBIUS_API_KEY=

# Token Factory OpenAI-compatible endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model ID for each tier. Run "lifeledger models" to see the current catalog.
LIFELEDGER_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
LIFELEDGER_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
LIFELEDGER_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Embedding model for memory recall.
LIFELEDGER_MODEL_EMBED=Qwen/Qwen3-Embedding-8B

# Maximum model spend per UTC day, in USD. 0 means no limit.
LIFELEDGER_DAILY_BUDGET_USD=2

# Tavily API key for web research. Get it at https://app.tavily.com.
# Leave it empty to turn web research off.
TAVILY_API_KEY=

# Tavily API endpoint.
TAVILY_BASE_URL=https://api.tavily.com

# Time between two sweeps in "serve". 0 turns the sweep off. The minimum is 1m.
LIFELEDGER_SWEEP_INTERVAL=15m

# LifeLedger makes reminders only at or after this local hour (0 to 23).
LIFELEDGER_REMIND_HOUR=9

# Local weekday and hour of the weekly review. Set the day to "off" to turn it off.
LIFELEDGER_REVIEW_DAY=sunday
LIFELEDGER_REVIEW_HOUR=18

# Telegram bot for reminders and reviews. Set both values, or leave both empty.
# Get the token from @BotFather. Get the chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP server for approved emails. Leave LIFELEDGER_SMTP_HOST empty to turn email off.
# Port 587 uses STARTTLS. Port 465 uses TLS. For Gmail, use an app password.
LIFELEDGER_SMTP_HOST=
LIFELEDGER_SMTP_PORT=587
LIFELEDGER_SMTP_USERNAME=
LIFELEDGER_SMTP_PASSWORD=
LIFELEDGER_SMTP_FROM=
